msgid "and"
msgstr "und"

#. translators: %1$s is the dotted CLI flag (e.g. smtp.pass). %2$s is the
#. matching environment variable name (e.g. WPMS_SMTP_PASS). Flag and env var
#. name are not translated.
#: src/WPCLI/Options/Help.php:161
msgid "Sensitive: also accepts --%1$s-file=<path> or env var %2$s."
msgstr "Sensitiv: Akzeptiert auch --%1$s-file=<Pfad> oder die Umgebungsvariable %2$s."

