msgid "Your Mailgun region is incorrect."
msgstr "Deine Mailgun-Region ist falsch."

#: src/Admin/EmailSendingErrors/EmailSendingErrors.php:1060
msgid "Your Mailgun domain has not been verified."
msgstr "Deine Mailgun-Domain wurde noch nicht verifiziert."

