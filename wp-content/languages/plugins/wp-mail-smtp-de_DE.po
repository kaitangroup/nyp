#: src/WPCLI/Commands/Option.php:60
msgid "Value (required for set; can also be supplied via --value-file or env var)."
msgstr "Wert (für die Einstellung erforderlich; kann auch über --value-file oder eine Umgebungsvariable angegeben werden)."

#: src/WPCLI/Commands/Option.php:61
msgid "Read a sensitive value from a file."
msgstr "Lies einen sensiblen Wert aus einer Datei aus."

#: src/WPCLI/Commands/Option.php:62
msgid "Show sensitive values instead of masking them."
msgstr "Zeige sensible Werte an, anstatt sie zu maskieren."

#: src/WPCLI/Commands/Option.php:63
msgid "Output format for `list`. table | json | yaml. Default: table."
msgstr "Ausgabeformat für `list`. table | json | yaml. Standard: table."

#: src/WPCLI/Commands/Option.php:125
msgid "Action must be one of: get, set, list."
msgstr "Die Aktion muss eine der folgenden sein: get, set, list."

#: src/WPCLI/Commands/Option.php:148
msgid "Usage: wp wp-mail-smtp option get <group>.<key>"
msgstr "Verwendung: wp wp-mail-smtp option get <Gruppe>.<Schlüssel>"

#. translators: %s is the unknown dotted CLI flag (e.g. smtp.host). The flag
#. itself is not translated.
#: src/WPCLI/Commands/Option.php:158 src/WPCLI/Commands/Option.php:214
#: src/WPCLI/Options/Writer.php:83 src/WPCLI/Options/Writer.php:217
msgid "Unknown flag: %s"
msgstr "Unbekanntes Flag: %s"

#: src/WPCLI/Commands/Option.php:171
msgid "(not set)"
msgstr "(nicht festgelegt)"

#: src/WPCLI/Commands/Option.php:204
msgid "Usage: wp wp-mail-smtp option set <group>.<key> <value>"
msgstr "Verwendung: wp wp-mail-smtp option set <Gruppe>.<Schlüssel> <Wert>"

#. translators: %1$s is the dotted CLI flag (e.g. smtp.host). %2$s is the
#. environment variable name the operator can use (e.g. WPMS_SMTP_HOST). Flag
#. and env var name are not translated.
#: src/WPCLI/Commands/Option.php:236
msgid "No value provided for --%1$s (positional, --value-file, or env var %2$s)."
msgstr "Für --%1$s (als Positionsargument, über die Wertedatei oder als Umgebungsvariable %2$s) wurde kein Wert angegeben."

#. translators: %s is the dotted CLI flag whose underlying option is overridden
#. by a wp-config constant (e.g. smtp.host). The flag itself is not translated.
#: src/WPCLI/Commands/Option.php:254
msgid "Could not store %s — value is shadowed by a wp-config constant."
msgstr "%s konnte nicht gespeichert werden – der Wert wird von einer Konstante in wp-config überschrieben."

#. translators: %s is the dotted CLI flag that was updated (e.g. smtp.host).
#. The flag itself is not translated.
#: src/WPCLI/Commands/Option.php:263
msgid "Updated %s."
msgstr "%s wurde aktualisiert."

#: src/WPCLI/Commands/Setup.php:29
msgid "Configure WP Mail SMTP from the command line."
msgstr "Konfiguriere WP Mail SMTP über die Befehlszeile."

#: src/WPCLI/Commands/Setup.php:45
msgid "Skip the refusal that fires when the plugin is already configured. Does NOT wipe existing settings — only flags you pass are written."
msgstr "Überspringe die Fehlermeldung, die erscheint, wenn das Plugin bereits konfiguriert ist. Vorhandene Einstellungen werden NICHT gelöscht – es werden nur die von dir übergebenen Flags geschrieben."

#. translators: %s is the currently configured mailer slug (e.g. smtp,
#. sendgrid). The slug is not translated.
#: src/WPCLI/Commands/Setup.php:91
msgid ""
"WP Mail SMTP is already configured (mailer: %s).\n"
"Use `wp wp-mail-smtp option set <group>.<key> <value>` to change individual settings, or pass --force to override this check."
msgstr ""
"WP Mail SMTP ist bereits konfiguriert (Mailer: %s).\n"
"Verwende `wp wp-mail-smtp option set <Gruppe>.<Schlüssel> <Wert>`, um einzelne Einstellungen zu ändern, oder gib --force an, um diese Überprüfung zu überspringen."

#: src/WPCLI/Commands/Setup.php:100
msgid "No configuration flags provided. Pass at least --mail.from_email, --mail.from_name, and --mail.mailer (plus the credentials for that mailer)."
msgstr "Es wurden keine Konfigurationsoptionen angegeben. Gib mindestens --mail.from_email, --mail.from_name und --mail.mailer an (sowie die Anmeldedaten für diesen Mailer)."

#: src/WPCLI/Commands/Setup.php:108
msgid "No settings were stored — every flag passed was shadowed by a wp-config constant. Remove the constants and re-run, or pass flags for non-shadowed settings."
msgstr "Es wurden keine Einstellungen gespeichert – jedes übergebene Flag wurde von einer Konstante in der wp-config überschrieben. Entferne die Konstanten und führe den Vorgang erneut aus, oder übergebe Flags für Einstellungen, die nicht überschrieben wurden."

#. translators: %s is the configured mailer slug (e.g. smtp, sendgrid). The
#. slug is not translated.
#: src/WPCLI/Commands/Setup.php:119
msgid "Configured WP Mail SMTP (mailer: %s). Run `wp wp-mail-smtp test <recipient>` to verify."
msgstr "WP Mail SMTP (Mailer: %s) wurde konfiguriert. Führe `wp wp-mail-smtp test <Empfänger>` aus, um das zu überprüfen."

#: src/WPCLI/Commands/Test.php:44
msgid "Pass a valid recipient: wp wp-mail-smtp test <recipient>"
msgstr "Gib einen gültigen Empfänger an: wp wp-mail-smtp test <Empfänger>"

#: src/WPCLI/Commands/Test.php:50
msgid "No mailer is configured. Run `wp wp-mail-smtp setup ...` first."
msgstr "Es ist kein Mailer konfiguriert. Führe zuerst `wp wp-mail-smtp setup ...` aus."

#. translators: %1$s is the recipient email address. %2$s is the mailer slug
#. (e.g. smtp, sendgrid). Recipient and mailer slug are not translated.
#: src/WPCLI/Commands/Test.php:70
msgid "Test email sent to %1$s via mailer \"%2$s\"."
msgstr "Test-E-Mail wurde über den Mailer „%2$s“ an %1$s gesendet."

#: src/WPCLI/Commands/Test.php:81
msgid "wp_mail() returned false (no further detail available)."
msgstr "wp_mail() hat „false“ zurückgegeben (keine weiteren Details verfügbar)."

#. translators: %s is the underlying error message returned by wp_mail() / the
#. mailer (already localized or quoted verbatim from the mailer response).
#: src/WPCLI/Commands/Test.php:86
msgid "Test email failed: %s"
msgstr "Test-E-Mail fehlgeschlagen: %s"

