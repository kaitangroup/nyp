msgid ""
"<h1 style=\"text-align: center;\"><strong>Hi, new subscriber!</strong></h1>\n"
"<p>&nbsp;</p>\n"
"<p>[subscriber:firstname | default:Subscriber],</p>\n"
"<p>&nbsp;</p>\n"
