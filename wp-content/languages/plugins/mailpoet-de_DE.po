"<p>Thanks for reading. See you soon!</p>\n"
"<p>&nbsp;</p>\n"
"<p><strong><em>The MailPoet Team</em></strong></p>"
msgstr ""
"<p>Danke für das Lesen. Bis bald!</p>\n"
"<p>&nbsp;</p>\n"
"<p><strong><em>Das MailPoet Team</em></strong></p>"

